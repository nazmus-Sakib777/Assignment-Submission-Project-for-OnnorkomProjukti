# Copy this file to `.env` (or map the values into appsettings.Development.json / user-secrets)
# and fill in real values. Never commit the real .env file.

# SQL Server connection
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=asms;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True

# JWT settings - Key must be a long random string (32+ chars) in real deployments
Jwt__Key=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__Issuer=AsmsApi
Jwt__Audience=AsmsClient
Jwt__ExpiresMinutes=480

# CORS
Cors__AllowedOrigins__0=http://localhost:3000

ASPNETCORE_ENVIRONMENT=Development
EnableSwagger=true
